"use client";

import React, { useRef, useState } from "react";
import gsap from "gsap";
import { useGSAP } from "@gsap/react";

interface PreloaderProps {
  onComplete: () => void;
}

export default function Preloader({ onComplete }: PreloaderProps) {
  const containerRef = useRef<HTMLDivElement>(null);
  const lineRef = useRef<HTMLDivElement>(null);
  const quoteRef = useRef<HTMLDivElement>(null);
  const nousDevRef = useRef<HTMLDivElement>(null);
  const [isReducedMotion, setIsReducedMotion] = useState(false);

  useGSAP(() => {
    const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
    setIsReducedMotion(motionQuery.matches);

    if (isReducedMotion) {
      const tl = gsap.timeline({
        onComplete: () => {
          gsap.to(containerRef.current, {
            duration: 0.8,
            opacity: 0,
            onComplete: onComplete,
          });
        },
      });
      tl.to([quoteRef.current, nousDevRef.current], { opacity: 1, duration: 0.5 });
      return;
    }

    const tl = gsap.timeline({
      onComplete: () => {
        gsap.to(containerRef.current, {
          duration: 1.2,
          opacity: 0,
          ease: "expo.inOut",
          onComplete: onComplete,
        });
      },
    });

    // INITIAL STATE
    tl.set(lineRef.current, { scaleX: 0, opacity: 0 });
    tl.set(quoteRef.current, { opacity: 0, y: 30, filter: "blur(10px)" });
    tl.set(nousDevRef.current, { opacity: 0, y: 20, scale: 0.9 });

    // 1. THE SILENCE
    tl.to({}, { duration: 0.6 });

    // 2. THE LINE (The spark)
    tl.to(lineRef.current, {
      opacity: 1,
      duration: 0.8,
      ease: "power2.inOut",
    });

    // 3. THE OPENING (Expanding the light)
    tl.to(lineRef.current, {
      scaleX: 1,
      duration: 1.4,
      ease: "expo.inOut",
    });

    // 4. THE SACRED REVELATION (The Quote)
    // We reveal the quote with a cinematic blur-to-focus effect
    tl.to(quoteRef.current, {
      opacity: 1,
      y: 0,
      filter: "blur(0px)",
      duration: 1.8,
      ease: "power3.out",
    }, "-=0.8");

    // 5. THE SIGNATURE (NOUSDEV)
    // a slight pause, then the brand appears as the ultimate seal
    tl.to(nousDevRef.current, {
      opacity: 1,
      y: 0,
      scale: 1,
      duration: 1.2,
      ease: "expo.out",
    }, "+=0.4");

    // 6. THE MOMENT OF IMPACT (Immobility)
    tl.to({}, { duration: 1.8 });

    // 7. THE FADE (Line disappears first)
    tl.to(lineRef.current, {
      opacity: 0,
      duration: 1,
      ease: "power2.inOut",
    });

    // 8. THE ASCENSION (Subtle move toward Hero)
    tl.to([quoteRef.current, nousDevRef.current], {
      y: -10,
      opacity: 0.8,
      duration: 1.5,
      ease: "sine.inOut",
    }, "-=0.6");

  }, { dependencies: [isReducedMotion], scope: containerRef });

  return (
    <div
      ref={containerRef}
      className="fixed inset-0 z-[9999] flex items-center justify-center bg-brand-black overflow-hidden"
    >
      {/* The Orange Light Line */}
      <div
        ref={lineRef}
        className="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-72 h-px bg-brand-orange z-20"
        style={{ transformOrigin: "center" }}
      />

      {/* Cinematic Content Stack */}
      <div className="relative z-10 flex flex-col items-center justify-center text-center select-none pointer-events-none px-6">

        {/* Quote Section */}
        <div ref={quoteRef} className="mb-12 flex flex-col items-center">
          <span className="text-xs md:text-sm font-body text-brand-orange tracking-[0.4em] uppercase mb-6 opacity-80">
            Proverbes 16:3
          </span>
          <h2 className="text-xl md:text-3xl lg:text-4xl font-body italic text-white leading-relaxed max-w-3xl mx-auto" style={{ fontWeight: 300 }}>
            « Recommande à l'Éternel tes œuvres, et tes projets réussiront. »
          </h2>
        </div>

        {/* Brand Section */}
        <div ref={nousDevRef} className="mt-4">
          <h1 className="text-5xl md:text-7xl lg:text-8xl font-heading text-white leading-none tracking-tighter uppercase" style={{ fontWeight: 900 }}>
            NOUSDEV
          </h1>
        </div>

      </div>
    </div>
  );
}
