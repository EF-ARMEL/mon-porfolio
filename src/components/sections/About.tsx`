"use client";

import React, { useRef } from "react";
import gsap from "gsap";
import { useGSAP } from "@gsap/react";
import { ScrollTrigger } from "gsap/ScrollTrigger";
import { useTranslation } from "react-i18next";
import { useAudio } from "@/context/AudioContext";

gsap.registerPlugin(ScrollTrigger);

export default function About() {
  const { t } = useTranslation();
  const { playSound } = useAudio();
  const sectionRef = useRef<HTMLDivElement>(null);
  const manifestoRef = useRef<HTMLDivElement>(null);
  const contentRef = useRef<HTMLDivElement>(null);

  useGSAP(() => {
    // Manifesto Reveal
    gsap.fromTo(manifestoRef.current,
      { opacity: 0, y: 100 },
      {
        opacity: 1,
        y: 0,
        duration: 1.5,
        ease: "power4.out",
        scrollTrigger: {
          trigger: manifestoRef.current,
          start: "top 80%",
        }
      }
    );

    // Content Stagger
    gsap.fromTo(".about-item",
      { opacity: 0, x: -50 },
      {
        opacity: 1,
        x: 0,
        duration: 1,
        stagger: 0.3,
        ease: "power3.out",
        scrollTrigger: {
          trigger: contentRef.current,
          start: "top 70%",
        }
      }
    );
  }, { scope: sectionRef });

  return (
    <section
      ref={sectionRef}
      id="about"
      className="relative w-full bg-brand-black text-white py-32 px-6 md:px-12 lg:px-24 overflow-hidden"
    >
      {/* Background Atmosphere */}
      <div className="absolute top-0 right-0 w-1/2 h-full bg-brand-orange/5 blur-[120px] rounded-full -translate-y-1/2 translate-x-1/4 pointer-events-none" />

      <div className="max-w-7xl mx-auto relative z-10">
        {/* 1. THE MANIFESTO */}
        <div
          ref={manifestoRef}
          className="mb-32 max-w-4xl"
        >
          <span className="text-brand-orange font-body uppercase tracking-[0.3em] text-xs mb-6 block">
            {t('about.manifesto_label')}
          </span>
          <h2 className="text-4xl md:text-6xl lg:text-7xl font-heading leading-[1.1] tracking-tighter uppercase">
            {t('about.manifesto_title')}
          </h2>
          <p className="mt-8 text-xl md:text-2xl font-body text-text-secondary leading-relaxed max-w-2xl">
            {t('about.manifesto_text')}
          </p>
        </div>

        {/* 2. THE CORE NARRATIVE */}
        <div ref={contentRef} className="grid grid-cols-1 lg:grid-cols-12 gap-16 items-start">
          <div className="lg:col-span-5 sticky top-32">
            <h3 className="text-3xl font-heading uppercase tracking-tighter mb-6">
              {t('about.journey_title')}
            </h3>
            <p className="text-text-secondary font-body leading-relaxed">
              {t('about.journey_description')}
            </p>

            <div className="mt-12 p-6 border-l-2 border-brand-orange bg-white/5 backdrop-blur-sm">
              <p className="text-sm italic font-body text-white/80">
                "{t('about.quote')}"
              </p>
            </div>
          </div>

          <div className="lg:col-span-7 space-y-24">
            {[1, 2, 3].map((item) => (
              <div key={item} className="about-item group relative pl-12">
                <div className="absolute left-0 top-0 w-px h-full bg-text-discrete group-hover:bg-brand-orange transition-colors duration-500" />
                <div className="absolute left-[-4px] top-2 w-2 h-2 rounded-full bg-brand-orange shadow-[0_0_10px_#FF6A00]" />

                <span className="text-xs font-body uppercase tracking-widest text-text-discrete mb-2 block">
                  {t(`about.step${item}_date`)}
                </span>
                <h4 className="text-2xl font-heading uppercase mb-4 group-hover:text-brand-orange transition-colors duration-300">
                  {t(`about.step${item}_title`)}
                </h4>
                <p className="text-text-secondary font-body leading-relaxed">
                  {t(`about.step${item}_text`)}
                </p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  );
}
