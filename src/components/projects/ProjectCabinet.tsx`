"use client";

import React, { useRef } from 'react';
import gsap from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
import { useGSAP } from '@gsap/react';
import { PROJECTS } from './projects-data';

gsap.registerPlugin(ScrollTrigger);

export default function ProjectCabinet() {
  const sectionRef = useRef(null);
  const cabinetRef = useRef(null);
  const stackRef = useRef(null);

  useGSAP(() => {
    const cards = gsap.utils.toArray('[data-card]');
    const slots = gsap.utils.toArray('[data-slot]');
    const drawers = gsap.utils.toArray('[data-drawer]');
    const fronts = gsap.utils.toArray('[data-front]');
    const folders = gsap.utils.toArray('[data-folder]');
    const hint = sectionRef.current?.querySelector('#hint');

    if (!cards.length) return;

    const getDelta = (index: number) => {
      const card = cards[index];
      const drawer = drawers[index];
      if (!card || !drawer) return { x: 0, y: 0, s: 1 };

      const cardRect = card.getBoundingClientRect();
      const drawerRect = drawer.getBoundingClientRect();

      return {
        x: drawerRect.left + drawerRect.width / 2 - (cardRect.left + cardRect.width / 2),
        y: drawerRect.top + drawerRect.height / 2 - (cardRect.top + cardRect.height / 2),
        s: Math.min(0.46, (drawerRect.width * 0.5) / cardRect.width)
      };
    };

    const mainTl = gsap.timeline({
      scrollTrigger: {
        trigger: sectionRef.current,
        start: "top top",
        end: "+=580%",
        pin: true,
        scrub: 1,
        anticipatePin: 1,
        invalidateOnRefresh: true,
      },
      defaults: { ease: "power3.out" }
    });

    // 0. Fade out external content (About, Hero, etc)
    // We use a more generic selector if classes aren't absolute
    mainTl.to(".grain-overlay", { autoAlpha: 0, duration: 0.5 }, 0);
    mainTl.to(".hero", { autoAlpha: 0, y: -100, duration: 0.8, ease: "power3.in" }, 0);
    mainTl.to(".about", { autoAlpha: 0, y: 100, duration: 0.8, ease: "power3.in" }, 0);
    mainTl.to(hint, { autoAlpha: 0, duration: 0.3 }, 0.5);

    // Pause of total black
    mainTl.to({}, { duration: 0.4 }, 0.8);

    const START = 1.2; // Moved slightly later to ensure clean screen
    const STEP = 2.4;

    cards.forEach((card, i) => {
      const base = START + i * STEP;
      const { x, y, s } = getDelta(i);

      mainTl.to(fronts[i], { yPercent: 70, scale: 1.04, duration: 0.6, ease: "power3.inOut" }, base)
            .to(folders[i], { y: -6, duration: 0.5 }, base + 0.1);

      mainTl.fromTo(card,
        { autoAlpha: 0, x: x, y: y, scale: s, rotate: (i - 1) * 6, transformOrigin: "50% 50%" },
        { autoAlpha: 1, y: y - 46, rotate: (1 - i) * 3, duration: 0.55, ease: "power2.out" },
        base + 0.4
      );

      mainTl.to(card, { x: 0, y: 0, scale: 1, rotate: 0, duration: 1.15, ease: "back.out(1.25)" }, base + 0.98);

      mainTl.to(slots[i], { borderColor: "rgba(255,255,255,0)", duration: 0.4 }, base + 1.6);
      mainTl.to(slots[i].querySelector('.slot-n'), { autoAlpha: 0, duration: 0.3 }, base + 0.6);
      mainTl.to(fronts[i], { yPercent: 0, scale: 1, duration: 0.6, ease: "power3.inOut" }, base + 1.5);
      mainTl.to(folders[i], { y: 0, duration: 0.5 }, base + 1.5);
    });

    mainTl.to({}, { duration: 0.9 });
  }, { scope: sectionRef });

  return (
    <section
      ref={sectionRef}
      id="projets"
      className="relative h-screen w-full overflow-hidden flex flex-col items-center gap-10 py-16 px-4 bg-[radial-gradient(70%_60%_at_50%_30%,#101016,#07070a)]"
    >
      <div className="absolute inset-0 top-0 z-30 flex justify-between px-5 pt-6 pointer-events-none text-[11px] font-bold tracking-[0.3em] uppercase">
        <span className="text-white/60">Sélection de projets</span>
        <span className="text-[#ffd000]">({PROJECTS.length.toString().padStart(2, '0')})</span>
      </div>

      <div
        ref={cabinetRef}
        className="relative z-10 w-full max-w-[880px] h-[clamp(120px,19svh,180px)] p-2.5 rounded-3xl border border-white/10 bg-gradient-to-br from-[#1b1b21] to-[#0c0c10] shadow-[0_40px_120px_-30px_rgba(0,0,0,0.9)]"
      >
        <div className="grid grid-cols-3 gap-2.5 h-full">
          {PROJECTS.map((p) => (
            <div key={p.id} data-drawer className="relative h-full">
              <div className="absolute inset-0 rounded-xl bg-black/80 shadow-[inset_0_10px_28px_rgba(0,0,0,0.95)]" />
              <div data-folder className="absolute inset-0 flex items-center justify-center">
                <svg viewBox="0 0 120 96" className="h-[66%] w-auto max-w-[80%] drop-shadow-[0_12px_18px_rgba(20,110,255,0.35)]" aria-hidden="true">
                  <path d="M8 14a8 8 0 0 1 8-8h26l10 10h52a8 8 0 0 1 8 8v58a8 8 0 0 1-8 8H16a8 8 0 1 8-8z" fill="url(#fb)" />
                  <rect x="4" y="28" width="112" height="62" rx="9" fill="url(#ff)" />
                  <rect x="4.5" y="28.5" width="111" height="61" rx="8.5" fill="none" stroke="currentColor" strokeOpacity="0.35" className="text-white" />
                </svg>
              </div>
              <div data-front className="absolute inset-0 z-10 rounded-xl border border-white/10 bg-gradient-to-b from-[#2b2b33] to-[#1616b1] shadow-[0_18px_30px_-10px_rgba(0,0,0,0.8)]">
                <div className="flex justify-between px-3 pt-2.5 text-[10px] font-bold tracking-[0.25em] uppercase text-white/55">
                  <b className="text-[#ff6a00]">{p.id}</b>
                  <span>{p.year}</span>
                </div>
                <p className="mx-2.5 mt-2 text-center font-display text-[12px] uppercase tracking-tight text-white/80 truncate">{p.title}</p>
                <span className="absolute bottom-2.5 left-1/2 w-[34%] h-1.25 rounded-full bg-white/25 -translate-x-1/2" />
              </div>
            </div>
          ))}
        </div>
      </div>

      <div
        ref={stackRef}
        className="relative z-10 w-full max-w-[880px] flex flex-col gap-[clamp(16px,3.6svh,36px)]"
      >
        <div id="hint" className="absolute inset-0 z-10 flex flex-col items-center justify-center gap-2 pointer-events-none text-[10px] font-bold tracking-[0.3em] uppercase text-white/50">
          Scroll<div className="w-px h-8 bg-gradient-to-b from-white/60 to-transparent" />
        </div>
        {PROJECTS.map((p) => (
          <div key={p.id} data-slot className="relative h-[clamp(104px,16svh,160px)] rounded-[20px] border border-dashed border-white/10">
            <span className="absolute left-5 top-1/2 -translate-y-1/2 text-[11px] font-bold tracking-[0.3em] uppercase text-white/20">
              Emplacement {p.id}
            </span>
            <a
              href={p.link}
              data-card
              className="absolute inset-0 flex overflow-hidden rounded-[20px] border border-white/10 bg-[#0e0e12] shadow-[0_24px_50px_-18px_rgba(0,0,0,0.9)]"
              aria-label={`Voir le projet ${p.title}`}
            >
              <div className="relative w-[30%] overflow-hidden">
                <div
                  className="absolute inset-0 transition-transform duration-1000 ease-out"
                  style={{ background: `linear-gradient(135deg, ${p.colors.a}, ${p.colors.b})` }}
                />
                <span className="absolute left-4 bottom-1.5 z-10 font-display text-[clamp(2.2rem,8vw,4.4rem)] leading-none text-white/90 mix-blend-overlay">
                  {p.id}
                </span>
              </div>
              <div className="flex-1 min-w-0 flex items-center justify-between gap-4 px-2 pr-5">
                <div className="flex flex-col gap-1.5">
                  <span className="text-[11px] font-bold tracking-[0.25em] uppercase text-[#ff6a00] tabular-nums">{p.year}</span>
                  <h3 className="m-0 font-display text-[clamp(1.1rem,3.6vw,1.9rem)] uppercase tracking-tight truncate">{p.title}</h3>
                  <ul className="hidden md:flex gap-2 mt-1 list-none p-0 m-0">
                    {p.tags.map((tag, idx) => (
                      <li key={idx} className="px-2.5 py-1 rounded-full border border-white/10 text-[10px] tracking-[0.15em] uppercase text-white/60">
                        {tag}
                      </li>
                    ))}
                  </ul>
                </div>
                <div className="w-10 h-10 rounded-full bg-gradient-to-br from-[#ff6a00] to-[#ffd000] text-black flex items-center justify-center transition-transform duration-500 hover:rotate-45">
                   <svg width="16" height="16" viewBox="0 0 24 24" fill="none" className="transition-transform">
                     <path d="M7 17L17 7M9 7h8v8" stroke="currentColor" strokeWidth="2.2" strokeLinecap="round" strokeLinejoin="round"/>
                   </svg>
                </div>
              </div>
            </a>
          </div>
        ))}
      </div>

      <svg className="absolute w-0 h-0 pointer-events-none">
        <defs>
          <linearGradient id="fb" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stopColor="#3b9bff" />
            <stop offset="1" stopColor="#1769d6" />
          </linearGradient>
          <linearGradient id="ff" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stopColor="#7fd0ff" />
            <stop offset="1" stopColor="#2d96ff" />
          </linearGradient>
        </defs>
      </svg>
    </section>
  );
}
