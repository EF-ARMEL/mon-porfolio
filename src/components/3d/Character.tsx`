"use client";

import React, { useRef } from "react";
import { useFrame } from "@react-three/fiber";
import { useTexture, Float } from "@react-three/drei";
import * as THREE from "three";

/**
 * Character est l'incarnation visuelle de Franck dans le monde NOUSDEV.
 * Il combine une image stylisée avec des animations de "vie" organiques.
 */
export default function Character() {
  const meshRef = useRef<THREE.Mesh>(null);
  const texture = useTexture("/image/ma_photo.png");

  useFrame((state) => {
    if (!meshRef.current) return;

    // 1. Interaction avec la souris (Regard/Léger mouvement)
    const { x, y } = state.mouse;
    const targetRotationX = -y * 0.1;
    const targetRotationY = x * 0.1;

    meshRef.current.rotation.x = THREE.MathUtils.lerp(
      meshRef.current.rotation.x,
      targetRotationX,
      0.1
    );
    meshRef.current.rotation.y = THREE.MathUtils.lerp(
      meshRef.current.rotation.y,
      targetRotationY,
      0.1
    );

    // 2. Animation de respiration subtile (pulsation)
    const time = state.clock.getElapsedTime();
    const scale = 1 + Math.sin(time * 1.5) * 0.02;
    meshRef.current.scale.set(scale, scale, scale);
  });

  return (
    <Float speed={1.5} rotationIntensity={0.2} floatIntensity={0.2}>
      <mesh ref={meshRef} position={[0, 0, 0]}>
        {/* Plan rectangulaire pour l'image */}
        <planeGeometry args={[2.5, 3.5]} />
        <meshStandardMaterial
          map={texture}
          transparent={true}
          roughness={0.3}
          metalness={0.2}
          side={THREE.DoubleSide}
        />
      </mesh>
    </Float>
  );
}
