[TEMPLATE]
# --- Quiz : question secrète ---
# Variantes acceptées, séparées par des virgules (jamais exposées au navigateur)
QUIZ_IDOL_ANSWERS="Prénom Nom,Nom,Alias"
# 32 caractères minimum, aléatoires : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QUIZ_SECRET=

# --- E-mail (SMTP) ---
# Gmail : smtp.gmail.com / 465 / true, avec un MOT DE PASSE D'APPLICATION (validation en 2 étapes requise)
# Brevo : smtp-relay.brevo.com / 587 / false
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nousdev <ton.adresse@exemple.com>"
# Destinataire des notifications de contact (défaut : SMTP_USER)
MAIL_TO=

# --- Admin ---
# Secret de session (32+ caractères) : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
# Hachage scrypt du mot de passe : générer APRÈS avoir défini ADMIN_SESSION_SECRET
#   ADMIN_SESSION_SECRET=... node scripts/hash-password.mjs "mon-mot-de-passe"
ADMIN_PASSWORD_HASH=
# Double authentification (2FA) par e-mail : adresse qui reçoit le code de
# connexion à 6 chiffres. Vide → 2FA désactivée (connexion au mot de passe seul).
# Si vide, MAIL_TO puis SMTP_USER sont utilisés en secours.
ADMIN_2FA_EMAIL=
# Le mot de passe peut être changé depuis le dashboard (Réglages) : le nouveau
# hachage est alors stocké en base (clé admin_password_hash) et prime sur
# ADMIN_PASSWORD_HASH ci-dessus.

# --- Base de données (production / Vercel) ---
# En dev, un fichier local ./data/portfolio.db est utilisé automatiquement.
# En production, renseigner une base Turso (https://turso.tech) :
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
